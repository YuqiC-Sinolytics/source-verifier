# Copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...

# Verification model. Sonnet is fast and cheap enough to run many claims in
# parallel, which is what you want here.
VERIFY_MODEL=claude-sonnet-5
REPAIR_MODEL=claude-sonnet-5

# Server tool versions. If the API rejects these, step down one release.
WEB_FETCH_TOOL=web_fetch_20260318
WEB_SEARCH_TOOL=web_search_20250305

# MOCK=1 runs the whole pipeline offline with built-in fixtures: no HTTP,
# no API calls. Your fallback when the venue wifi or your quota dies.
MOCK=0

# Concurrency cap. Too high and you will hit rate limits.
MAX_CONCURRENCY=6

# Max tokens of fetched page content handed to the model per source.
MAX_CONTENT_TOKENS=30000
