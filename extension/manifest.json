{
  "manifest_version": 3,
  "name": "Source Verifier",
  "version": "0.1.0",
  "description": "Right-click a cited link to check whether the page it points at actually supports the sentence it is attached to.",
  "permissions": ["contextMenus", "storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Source Verifier — right-click any link to verify it"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
